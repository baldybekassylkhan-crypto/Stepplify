generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  fullName     String
  region       String
  district     String
  school       String
  grade        String
  points       Int      @default(0)
  level        Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  articles  Article[]
  pointLogs PointLog[]
}

model Article {
  id           Int      @id @default(autoincrement())
  title        String
  content      String
  category     String
  images       String   @default("[]")
  geoLat       Float?
  geoLng       Float?
  locationName String?
  viewsCount   Int      @default(0)
  authorId     Int
  author       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PointLog {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points    Int
  reason    String
  createdAt DateTime @default(now())
}

model Winner {
  id          Int      @id @default(autoincrement())
  name        String
  meta        String
  destination String
  img         String
  quote       String
  createdAt   DateTime @default(now())
}
